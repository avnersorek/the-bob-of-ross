{
  "name": "the-bob-of-ross",
  "version": "0.1.0",
  "description": "Paint along with Bob Ross in real time: a YouTube-synced canvas that swaps brush, color, size and blend mode from a time-coded JSON script.",
  "private": true,
  "license": "MIT",
  "author": "Avner Sorek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avnersorek/the-bob-of-ross.git"
  },
  "homepage": "https://github.com/avnersorek/the-bob-of-ross#readme",
  "bugs": {
    "url": "https://github.com/avnersorek/the-bob-of-ross/issues"
  },
  "keywords": [
    "bob-ross",
    "the-joy-of-painting",
    "canvas",
    "generative-art",
    "creative-coding",
    "youtube-iframe-api",
    "typescript",
    "vite",
    "zod"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write src tests",
    "typecheck": "tsc --noEmit",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.8.4",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "canvas": "^3.2.3",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.3.3",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
